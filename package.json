{
  "name": "Runebase-Lite-Wallet",
  "description": "LightWeight wallet for the Runebase blockchain",
  "author": {
    "name": "Bago",
    "email": "support@runebase.io"
  },
  "version": "2.4.1",
  "homepage": "https://github.com/runebase/runebase-lite-wallet",
  "private": true,
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "vite",
    "dev:browser": "vite",
    "dev:ext": "npm run build:ext -- --watch & web-ext run --source-dir dist --target=chromium --start-url about:debugging",
    "build": "vite build --config vite.config.extension.ts",
    "build:ext": "vite build --config vite.config.extension.ts",
    "release:patch": "./scripts/bump-version.sh patch",
    "release:minor": "./scripts/bump-version.sh minor",
    "release:major": "./scripts/bump-version.sh major",
    "build:mobile": "vite build --config vite.config.capacitor.ts",
    "cap:sync": "npx cap sync",
    "cap:android": "npm run build:mobile && npx cap sync android && npx cap open android",
    "cap:run:android": "npm run build:mobile && npx cap sync android && npx cap run android",
    "start:electron": "electron ./electron/main.js",
    "typecheck": "tsc --noEmit",
    "typecheck:ts6": "tsc6 --noEmit",
    "lint": "eslint src/",
    "lint-fix": "eslint src/ --fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "npm run lint-fix"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "terser": "^5.50.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vm-browserify": "^1.1.2"
  },
  "dependencies": {
    "@bitcoinerlab/secp256k1": "^2.0.0",
    "@capacitor-mlkit/barcode-scanning": "^8.1.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@noble/hashes": "^1.8.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@types/node": "^26.3.0",
    "assert": "^2.1.0",
    "bignumber.js": "^11.1.5",
    "bip32": "^5.0.1",
    "bip38": "^3.1.1",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^7.0.1",
    "buffer": "^6.0.3",
    "classnames": "^2.5.1",
    "coinselect": "^3.1.13",
    "crypto-browserify": "^3.12.1",
    "dayjs": "^1.11.23",
    "dexie": "^4.4.5",
    "ecpair": "^3.0.1",
    "electron-progressbar": "^2.2.1",
    "electron-updater": "^6.8.9",
    "ethers": "^6.17.0",
    "events": "^3.3.0",
    "process": "^0.11.10",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "react-router": "^8.3.0",
    "stream-browserify": "^3.0.0",
    "tss-react": "^4.9.21",
    "util": "^0.12.5",
    "wif": "^5.0.0"
  },
  "main": "electron/main.js"
}
